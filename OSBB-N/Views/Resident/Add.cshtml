@using OSBB_N.ViewModels;
@model ResidentViewModel

@{
    ViewBag.Title = "Додати мешканця";
}

<h2>Додати мешканця</h2>

@using (Html.BeginForm("Add", "Resident", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    <hr />
    @Html.Partial("_ResidentFields", Model)

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Додати" class="btn btn-default" />
            @Html.ActionLink("Скасувати", "Index", routeValues: null, htmlAttributes: new { @class = "btn btn-link" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
