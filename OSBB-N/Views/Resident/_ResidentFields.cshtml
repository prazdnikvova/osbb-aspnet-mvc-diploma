@using OSBB_N.ViewModels;
@model ResidentViewModel

@* Поля мешканця, спільні для форм Add і Edit *@

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@if (!Model.Flats.Any())
{
    <p class="text-warning">У базі ще немає квартир. Спочатку @Html.ActionLink("додайте квартиру", "AddNewFlat", "Flat").</p>
}

<div class="form-group">
    @Html.LabelFor(m => m.Pib, new { @class = "col-md-2 control-label" })
    <div class="col-md-10">
        @Html.TextBoxFor(m => m.Pib, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Pib, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(m => m.FlatId, new { @class = "col-md-2 control-label" })
    <div class="col-md-10">
        @Html.DropDownListFor(m => m.FlatId, Model.Flats, "— оберіть квартиру —", new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.FlatId, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(m => m.PhoneNumber, new { @class = "col-md-2 control-label" })
    <div class="col-md-10">
        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    @Html.LabelFor(m => m.Email, new { @class = "col-md-2 control-label" })
    <div class="col-md-10">
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        <div class="checkbox">
            <label>
                @Html.CheckBoxFor(m => m.IsOwner)
                @Html.DisplayNameFor(m => m.IsOwner)
            </label>
        </div>
    </div>
</div>
