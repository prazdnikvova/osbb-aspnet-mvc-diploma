@using OSBB_N.Models.House;
@model List<Flat>


@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>
@Html.ActionLink("Register New", "AddNewFlat")


<table class="table table-striped table-bordered">
    <tr>
        <th>
            IP квартири
        </th>
        <th>
            ПІБ власника
        </th>
        <th>
            Адреса
        </th>
        <th>
            Номер домашнього телефону
        </th>
        <th>
            Площа квартири
        </th>
        <th>
            Ціна за метр
        </th>
        <th>
            Оплата всього
        </th>
        <th>
            З субсидією
        </th>
        <th>
            З пільгою 50%
        </th>
        <th>
            З пільгою 75%
        </th>
        @*<th>
            FlatName
        </th>
        <th>
            FlatName
        </th>*@
    </tr>
    @foreach (var item in Model)
    {
    <tr>
        @*<td>
            @Html.DisplayFor(modelItem => item.FlatId)
        </td>*@
        <td>
            @Html.DisplayFor(modelItem => item.FlatIp1)
        </td>
        @*<td>
            @Html.DisplayFor(modelItem => item.FlatName)
        </td>*@
        <td>
            @Html.DisplayFor(modelItem => item.Pib)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Address)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PhoneNumber)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AreaMetr)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CostMetr)
        </td>
        @*<td>
            @Html.DisplayFor(modelItem => item.CostMetr2)
        </td>*@
        <td>
            @Html.DisplayFor(modelItem => item.CostOll)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CostSubsidy)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CostPrivilege50)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CostPrivilege75)
        </td>
        <td>
            @Html.ActionLink("Edit", "EditFlat", new { id = item.FlatId })
            @Html.ActionLink("Add", "AddNewFlat", new { id = item.FlatId })
            @Html.ActionLink("Delete", "DeleteFlat", new { id = item.FlatId })
        </td>
    </tr>
    }

</table>
